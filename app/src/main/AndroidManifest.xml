<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permissão para desenhar por cima dos outros apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Permissão para rodar serviço em primeiro plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <package android:name="com.dts.freefireth" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="freefire" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo"
        android:label="QZZ Panel"
        android:supportsRtl="true"
        android:theme="@style/Theme.QZZPanel">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registrando o Overlay -->
        <service 
            android:name=".OverlayService" 
            android:foregroundServiceType="specialUse" />
            
    </application>
</manifest>